{
  "name": "@local/usage-cost",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Estimate DeepSeek token spend per turn, with a left-sidebar usage panel.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
